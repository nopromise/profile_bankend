name: Docker Build and Push to Aliyun

on:
  push:
    branches:
      - master  # 保持你原有的 master 分支触发

jobs:
  # ==========================================
  # Job 1: 持续集成与镜像打包 (CI 阶段)
  # ==========================================
  build-and-push:
    runs-on: ubuntu-latest
    # 这一步很关键：将打包出来的唯一 Tag 变成这个 Job 的输出变量，方便下一个 Job 引用
    outputs:
      image_tag: ${{ steps.set-tag.outputs.tag }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Login to Aliyun ACR
        uses: aliyun/acr-login@v1
        with:
          login-server: ${{ vars.REGISTRY }}
          username: ${{ vars.ALIBABA_CLOUD_USERNAME }}
          password: ${{ secrets.ALIBABA_CLOUD_PASSWORD }}

      # 设置唯一的 Tag：大厂标准做法，取 GitHub SHA 的前 7 位作为短哈希，避免 latest 的坑
      - name: Set Short SHA Tag
        id: set-tag
        run: echo "tag=sha-${GITHUB_SHA::7}" >> $GITHUB_OUTPUT

      - name: Build and Push Docker Image
        run: |
          IMAGE_NAME=${{ vars.REGISTRY }}/finn_test/profile_bankend          
          IMAGE_TAG=${{ steps.set-tag.outputs.tag }}
          
          # 构建并推送基于唯一 Git SHA 的镜像
          docker build -t $IMAGE_NAME:$IMAGE_TAG .          
          docker push $IMAGE_NAME:$IMAGE_TAG          
          
          # 保留你的 latest 备份，但 K8s 之后将不再依赖它
          docker tag $IMAGE_NAME:$IMAGE_TAG $IMAGE_NAME:latest
          docker push $IMAGE_NAME:latest

  # ==========================================
  # Job 2: 衔接阶段 —— 自动化修改 K8s 配置仓库 (CD 的桥梁)
  # ==========================================
  # ==========================================
  # Job 2: 衔接阶段 —— 自动化修改 K8s 配置仓库 (CD 的桥梁)
  # ==========================================
  update-k8s-manifest:
    needs: build-and-push # 必须等上面镜像推成功后，才执行本任务
    runs-on: ubuntu-latest
    steps:
      # 步骤一：克隆你的【K8s 配置仓库】
      - name: Checkout Manifest Repo
        uses: actions/checkout@v3
        with:
          repository: 'nopromise/profile-manifests' # 👈 确保这里是你的配置仓库路径
          token: ${{ secrets.MY_GITHUB_TOKEN }}

      # 步骤二：使用大厂标准的 yq 工具，精准定位并修改 YAML 节点值
      - name: Update Image Tag using yq
        run: |
          NEW_TAG=${{ needs.build-and-push.outputs.image_tag }}
          TARGET_FILE="k8s/backend-k8s.yaml"
          FULL_IMAGE_PATH="${{ vars.REGISTRY }}/finn_test/profile_bankend:$NEW_TAG"
          
          echo "🎯 目标新镜像完整路径: $FULL_IMAGE_PATH"
          
          # 安装 yq 工具（Ubuntu 虚拟机里最快、最稳的安装方式）
          sudo wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/bin/yq && sudo chmod +x /usr/bin/yq
          
          # 【核心魔术】：利用 yq 精准修改第一个 document (Deployment) 的镜像地址
          # 语法解释：(select( .kind == "Deployment" ) 表示只改 Deployment，不碰下面的 Service
          yq -i '(select(.kind == "Deployment") | .spec.template.spec.containers[0].image) = "'$FULL_IMAGE_PATH'"' $TARGET_FILE
          
          echo "==== 修改后的 YAML 文件内容预览 ===="
          cat $TARGET_FILE

      # 步骤三：安全提交，防止 nothing to commit 报错
      - name: Commit and Push to Manifest Repo
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          git add k8s/backend-k8s.yaml
          
          # 检查文件是否真的被修改了
          if git diff --staged --quiet; then
            echo "📢 检查完毕：本地生成的镜像 Tag 与配置仓库中的完全一致，无需重复提交！"
          else
            git commit -m "chore: 自动化更新后端镜像标签至 ${{ needs.build-and-push.outputs.image_tag }} [skip ci]"
            git push origin main
          fi